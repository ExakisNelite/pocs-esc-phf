    {
      "mode": "managed",
      "type": "azurerm_monitor_data_collection_endpoint",
      "name": "pr_metrics",
      "provider": "provider[\"registry.terraform.io/hashicorp/azurerm\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
