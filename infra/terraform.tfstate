    {
      "mode": "managed",
      "type": "azurerm_application_insights_workbook",
      "name": "pr_leadtime",
      "provider": "provider[\"registry.terraform.io/hashicorp/azurerm\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "category": "workbook",
            "data_json": "{\r\n  \"$schema\": \"https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json\",\r\n  \"version\": \"Notebook/1.0\",\r\n  \"items\": [\r\n    {\r\n      \"type\": 1,\r\n      \"content\": {\r\n        \"json\": \"## Pull Request — Lead time de prise en charge et de revue\\n\\nObjectifs de service : **prise en charge sous 48h ouvrées**, **revue terminée sous 96h ouvrées**.\\nLes heures ouvrées excluent les week-ends ; les jours fériés ne sont pas déduits.\\nUne PR clôturée sans que le label de revue ait été posé est comptée séparément (« sans prise en charge ») et non comme une revue conforme.\"\r\n      },\r\n      \"name\": \"header\"\r\n    },\r\n    {\r\n      \"type\": 9,\r\n      \"content\": {\r\n        \"version\": \"KqlParameterItem/1.0\",\r\n        \"parameters\": [\r\n          {\r\n            \"id\": \"b1e1a0d2-0f5a-4a1e-9d1a-1f0a2b3c4d5e\",\r\n            \"version\": \"KqlParameterItem/1.0\",\r\n            \"name\": \"TimeRange\",\r\n            \"label\": \"Période\",\r\n            \"type\": 4,\r\n            \"isRequired\": true,\r\n            \"value\": {\r\n              \"durationMs\": 7776000000\r\n            },\r\n            \"typeSettings\": {\r\n              \"selectableValues\": [\r\n                { \"durationMs\": 2592000000 },\r\n                { \"durationMs\": 5184000000 },\r\n                { \"durationMs\": 7776000000 },\r\n                { \"durationMs\": 15552000000 },\r\n                { \"durationMs\": 31536000000 }\r\n              ],\r\n              \"allowCustom\": true\r\n            }\r\n          },\r\n          {\r\n            \"id\": \"c2f2b1e3-1a6b-4b2f-8e2b-2a1b3c4d5e6f\",\r\n            \"version\": \"KqlParameterItem/1.0\",\r\n            \"name\": \"Application\",\r\n            \"label\": \"Application\",\r\n            \"type\": 2,\r\n            \"multiSelect\": true,\r\n            \"quote\": \"'\",\r\n            \"delimiter\": \",\",\r\n            \"isRequired\": true,\r\n            \"query\": \"PullRequestMetrics_CL\\n| where TimeGenerated {TimeRange}\\n| distinct c_application\\n| order by c_application asc\\n| summarize v = make_list(c_application)\\n| extend v = array_concat(pack_array('*'), v)\\n| mv-expand v to typeof(string)\\n| project value = v, label = iff(v == '*', 'Toutes', v), selected = v == '*'\",\r\n            \"typeSettings\": {\r\n              \"showDefault\": false\r\n            },\r\n            \"queryType\": 0,\r\n            \"resourceType\": \"microsoft.operationalinsights/workspaces\",\r\n            \"value\": [\"*\"]\r\n          },\r\n          {\r\n            \"id\": \"d3a3c2f4-2b7c-4c3a-9f3c-3b2c4d5e6f70\",\r\n            \"version\": \"KqlParameterItem/1.0\",\r\n            \"name\": \"Repo\",\r\n            \"label\": \"Dépôt\",\r\n            \"type\": 2,\r\n            \"multiSelect\": true,\r\n            \"quote\": \"'\",\r\n            \"delimiter\": \",\",\r\n            \"isRequired\": true,\r\n            \"query\": \"PullRequestMetrics_CL\\n| where TimeGenerated {TimeRange}\\n| where '*' in ({Application}) or c_application in ({Application})\\n| distinct c_repo\\n| order by c_repo asc\\n| summarize v = make_list(c_repo)\\n| extend v = array_concat(pack_array('*'), v)\\n| mv-expand v to typeof(string)\\n| project value = v, label = iff(v == '*', 'Tous', v), selected = v == '*'\",\r\n            \"typeSettings\": {\r\n              \"showDefault\": false\r\n            },\r\n            \"queryType\": 0,\r\n            \"resourceType\": \"microsoft.operationalinsights/workspaces\",\r\n            \"value\": [\"*\"]\r\n          }\r\n        ],\r\n        \"style\": \"pills\",\r\n        \"queryType\": 0,\r\n        \"resourceType\": \"microsoft.operationalinsights/workspaces\"\r\n      },\r\n      \"name\": \"parameters\"\r\n    },\r\n    {\r\n      \"type\": 1,\r\n      \"content\": {\r\n        \"json\": \"### État courant du flux de revue\\n\\nCes compteurs ignorent la période sélectionnée : ils décrivent les PR ouvertes à l'instant présent.\"\r\n      },\r\n      \"name\": \"text-etat-courant\"\r\n    },\r\n    {\r\n      \"type\": 3,\r\n      \"content\": {\r\n        \"version\": \"KqlItem/1.0\",\r\n        \"query\": \"// Heures ouvrées : week-ends exclus, jours ouvrés comptés 24h\\nlet MondayEpoch = datetime(1970-01-05);\\nlet dayIdx = (t: datetime) { toint(datetime_diff('day', startofday(t), MondayEpoch)) };\\nlet weekendDaysBefore = (n: int) { 2 * (n / 7) + max_of(0, min_of(2, n % 7 - 5)) };\\nlet bizHours = (s: datetime, e: datetime) {\\n    let s2 = case(dayofweek(s) == 6d, startofday(s) + 2d, dayofweek(s) == 0d, startofday(s) + 1d, s);\\n    let e2 = case(dayofweek(e) == 6d, startofday(e), dayofweek(e) == 0d, startofday(e) - 1d, e);\\n    iff(e2 \u003c= s2, 0.0, datetime_diff('second', e2, s2) / 3600.0 - 24.0 * (weekendDaysBefore(dayIdx(e2)) - weekendDaysBefore(dayIdx(s2))))\\n};\\nlet lookback = 365d;\\nlet closedCycles = PullRequestMetrics_CL\\n    | where TimeGenerated \u003e ago(lookback) and c_eventType in ('merged', 'closed')\\n    | distinct c_repo, c_prNumber, c_cycleStartAt;\\nlet openCycles = PullRequestMetrics_CL\\n    | where TimeGenerated \u003e ago(lookback)\\n    | where c_eventType in ('created', 'reopened', 'review_started')\\n    | where '*' in ({Application}) or c_application in ({Application})\\n    | where '*' in ({Repo}) or c_repo in ({Repo})\\n    | summarize arg_max(TimeGenerated, *) by c_repo, c_prNumber, c_cycleStartAt\\n    | join kind=leftanti closedCycles on c_repo, c_prNumber, c_cycleStartAt;\\nlet waiting = openCycles\\n    | where c_eventType != 'review_started'\\n    | extend H = bizHours(todatetime(c_cycleStartAt), now());\\nlet inReview = openCycles\\n    | where c_eventType == 'review_started'\\n    | extend H = bizHours(todatetime(c_reviewStartedAt), now());\\nunion\\n  (waiting | summarize Nb = count() | extend Indicateur = '1. À prendre en charge'),\\n  (waiting | where H \u003c= 48 | summarize Nb = count() | extend Indicateur = '2. Dont \u003c 48h ouvrées'),\\n  (waiting | where H \u003e 48 | summarize Nb = count() | extend Indicateur = '3. Dont \u003e 48h ouvrées'),\\n  (inReview | summarize Nb = count() | extend Indicateur = '4. En cours de revue'),\\n  (inReview | where H \u003e 96 | summarize Nb = count() | extend Indicateur = '5. Dont revue \u003e 96h ouvrées')\\n| project Indicateur, Nb\\n| sort by Indicateur asc\",\r\n        \"size\": 3,\r\n        \"queryType\": 0,\r\n        \"resourceType\": \"microsoft.operationalinsights/workspaces\",\r\n        \"visualization\": \"tiles\",\r\n        \"tileSettings\": {\r\n          \"titleContent\": {\r\n            \"columnMatch\": \"Indicateur\",\r\n            \"formatter\": 1\r\n          },\r\n          \"leftContent\": {\r\n            \"columnMatch\": \"Nb\",\r\n            \"formatter\": 12,\r\n            \"formatOptions\": {\r\n              \"palette\": \"auto\"\r\n            },\r\n            \"numberFormat\": {\r\n              \"unit\": 17,\r\n              \"options\": {\r\n                \"style\": \"decimal\",\r\n                \"maximumFractionDigits\": 0\r\n              }\r\n            }\r\n          },\r\n          \"showBorder\": true,\r\n          \"size\": \"auto\"\r\n        }\r\n      },\r\n      \"name\": \"tiles-etat-courant\"\r\n    },\r\n    {\r\n      \"type\": 1,\r\n      \"content\": {\r\n        \"json\": \"### PR hors délai\\n\\nTri par dépassement décroissant. Liste vide = aucun engagement rompu.\"\r\n      },\r\n      \"name\": \"text-hors-delai\"\r\n    },\r\n    {\r\n      \"type\": 3,\r\n      \"content\": {\r\n        \"version\": \"KqlItem/1.0\",\r\n        \"query\": \"// Heures ouvrées : week-ends exclus, jours ouvrés comptés 24h\\nlet MondayEpoch = datetime(1970-01-05);\\nlet dayIdx = (t: datetime) { toint(datetime_diff('day', startofday(t), MondayEpoch)) };\\nlet weekendDaysBefore = (n: int) { 2 * (n / 7) + max_of(0, min_of(2, n % 7 - 5)) };\\nlet bizHours = (s: datetime, e: datetime) {\\n    let s2 = case(dayofweek(s) == 6d, startofday(s) + 2d, dayofweek(s) == 0d, startofday(s) + 1d, s);\\n    let e2 = case(dayofweek(e) == 6d, startofday(e), dayofweek(e) == 0d, startofday(e) - 1d, e);\\n    iff(e2 \u003c= s2, 0.0, datetime_diff('second', e2, s2) / 3600.0 - 24.0 * (weekendDaysBefore(dayIdx(e2)) - weekendDaysBefore(dayIdx(s2))))\\n};\\nlet lookback = 365d;\\nlet closedCycles = PullRequestMetrics_CL\\n    | where TimeGenerated \u003e ago(lookback) and c_eventType in ('merged', 'closed')\\n    | distinct c_repo, c_prNumber, c_cycleStartAt;\\nPullRequestMetrics_CL\\n| where TimeGenerated \u003e ago(lookback)\\n| where c_eventType in ('created', 'reopened', 'review_started')\\n| where '*' in ({Application}) or c_application in ({Application})\\n| where '*' in ({Repo}) or c_repo in ({Repo})\\n| summarize arg_max(TimeGenerated, *) by c_repo, c_prNumber, c_cycleStartAt\\n| join kind=leftanti closedCycles on c_repo, c_prNumber, c_cycleStartAt\\n| extend EnRevue = c_eventType == 'review_started'\\n| extend Etat = iff(EnRevue, 'En revue', 'À prendre en charge'),\\n         Cible = iff(EnRevue, 96.0, 48.0),\\n         H = iff(EnRevue, bizHours(todatetime(c_reviewStartedAt), now()), bizHours(todatetime(c_cycleStartAt), now()))\\n| extend Depassement_h = round(H - Cible, 1)\\n| where Depassement_h \u003e 0\\n| project Application = c_application, Depot = c_repo, PR = c_prNumber, Titre = c_prTitle, Auteur = c_prAuthor, Etat, Ecoule_h = round(H, 1), Cible_h = Cible, Depassement_h, Lien = c_prUrl\\n| sort by Depassement_h desc\",\r\n        \"size\": 0,\r\n        \"queryType\": 0,\r\n        \"resourceType\": \"microsoft.operationalinsights/workspaces\",\r\n        \"visualization\": \"table\",\r\n        \"gridSettings\": {\r\n          \"formatters\": [\r\n            {\r\n              \"columnMatch\": \"Depassement_h\",\r\n              \"formatter\": 8,\r\n              \"formatOptions\": {\r\n                \"palette\": \"red\"\r\n              },\r\n              \"numberFormat\": {\r\n                \"unit\": 24,\r\n                \"options\": {\r\n                  \"style\": \"decimal\",\r\n                  \"maximumFractionDigits\": 1\r\n                }\r\n              }\r\n            },\r\n            {\r\n              \"columnMatch\": \"Lien\",\r\n              \"formatter\": 7,\r\n              \"formatOptions\": {\r\n                \"linkTarget\": \"Url\",\r\n                \"linkLabel\": \"Ouvrir\"\r\n              }\r\n            }\r\n          ],\r\n          \"filter\": true\r\n        }\r\n      },\r\n      \"name\": \"grid-hors-delai\"\r\n    },\r\n    {\r\n      \"type\": 1,\r\n      \"content\": {\r\n        \"json\": \"### Volume de revues mois par mois\\n\\nLes PR sont rattachées au mois de leur clôture.\"\r\n      },\r\n      \"name\": \"text-mensuel\"\r\n    },\r\n    {\r\n      \"type\": 3,\r\n      \"content\": {\r\n        \"version\": \"KqlItem/1.0\",\r\n        \"query\": \"// Heures ouvrées : week-ends exclus, jours ouvrés comptés 24h\\nlet MondayEpoch = datetime(1970-01-05);\\nlet dayIdx = (t: datetime) { toint(datetime_diff('day', startofday(t), MondayEpoch)) };\\nlet weekendDaysBefore = (n: int) { 2 * (n / 7) + max_of(0, min_of(2, n % 7 - 5)) };\\nlet bizHours = (s: datetime, e: datetime) {\\n    let s2 = case(dayofweek(s) == 6d, startofday(s) + 2d, dayofweek(s) == 0d, startofday(s) + 1d, s);\\n    let e2 = case(dayofweek(e) == 6d, startofday(e), dayofweek(e) == 0d, startofday(e) - 1d, e);\\n    iff(e2 \u003c= s2, 0.0, datetime_diff('second', e2, s2) / 3600.0 - 24.0 * (weekendDaysBefore(dayIdx(e2)) - weekendDaysBefore(dayIdx(s2))))\\n};\\nPullRequestMetrics_CL\\n| where TimeGenerated {TimeRange}\\n| where c_eventType in ('merged', 'closed')\\n| where '*' in ({Application}) or c_application in ({Application})\\n| where '*' in ({Repo}) or c_repo in ({Repo})\\n| extend PriseEnCharge_h = bizHours(todatetime(c_cycleStartAt), todatetime(c_reviewStartedAt)),\\n         Revue_h = bizHours(todatetime(c_reviewStartedAt), todatetime(c_closedAt))\\n| summarize\\n    ['Revue conforme'] = countif(isnotnull(c_reviewStartedAt) and PriseEnCharge_h \u003c= 48 and Revue_h \u003c= 96),\\n    ['Prise en charge \u003e 48h'] = countif(isnotnull(c_reviewStartedAt) and PriseEnCharge_h \u003e 48),\\n    ['Revue \u003e 96h'] = countif(isnotnull(c_reviewStartedAt) and PriseEnCharge_h \u003c= 48 and Revue_h \u003e 96),\\n    ['Sans prise en charge'] = countif(isnull(c_reviewStartedAt))\\n  by Mois = startofmonth(TimeGenerated)\\n| sort by Mois asc\",\r\n        \"size\": 0,\r\n        \"queryType\": 0,\r\n        \"resourceType\": \"microsoft.operationalinsights/workspaces\",\r\n        \"visualization\": \"barchart\",\r\n        \"chartSettings\": {\r\n          \"xAxis\": \"Mois\",\r\n          \"group\": null,\r\n          \"createOtherGroup\": null,\r\n          \"seriesLabelSettings\": [\r\n            { \"seriesName\": \"Revue conforme\", \"color\": \"green\" },\r\n            { \"seriesName\": \"Prise en charge \u003e 48h\", \"color\": \"orange\" },\r\n            { \"seriesName\": \"Revue \u003e 96h\", \"color\": \"redBright\" },\r\n            { \"seriesName\": \"Sans prise en charge\", \"color\": \"gray\" }\r\n          ]\r\n        }\r\n      },\r\n      \"name\": \"chart-mensuel\"\r\n    },\r\n    {\r\n      \"type\": 3,\r\n      \"content\": {\r\n        \"version\": \"KqlItem/1.0\",\r\n        \"query\": \"// Heures ouvrées : week-ends exclus, jours ouvrés comptés 24h\\nlet MondayEpoch = datetime(1970-01-05);\\nlet dayIdx = (t: datetime) { toint(datetime_diff('day', startofday(t), MondayEpoch)) };\\nlet weekendDaysBefore = (n: int) { 2 * (n / 7) + max_of(0, min_of(2, n % 7 - 5)) };\\nlet bizHours = (s: datetime, e: datetime) {\\n    let s2 = case(dayofweek(s) == 6d, startofday(s) + 2d, dayofweek(s) == 0d, startofday(s) + 1d, s);\\n    let e2 = case(dayofweek(e) == 6d, startofday(e), dayofweek(e) == 0d, startofday(e) - 1d, e);\\n    iff(e2 \u003c= s2, 0.0, datetime_diff('second', e2, s2) / 3600.0 - 24.0 * (weekendDaysBefore(dayIdx(e2)) - weekendDaysBefore(dayIdx(s2))))\\n};\\nPullRequestMetrics_CL\\n| where TimeGenerated {TimeRange}\\n| where c_eventType in ('merged', 'closed')\\n| where '*' in ({Application}) or c_application in ({Application})\\n| where '*' in ({Repo}) or c_repo in ({Repo})\\n| extend PriseEnCharge_h = bizHours(todatetime(c_cycleStartAt), todatetime(c_reviewStartedAt)),\\n         Revue_h = bizHours(todatetime(c_reviewStartedAt), todatetime(c_closedAt))\\n| summarize\\n    Cloturees = count(),\\n    Revues = countif(isnotnull(c_reviewStartedAt)),\\n    SansPriseEnCharge = countif(isnull(c_reviewStartedAt)),\\n    OkPriseEnCharge = countif(PriseEnCharge_h \u003c= 48),\\n    OkRevue = countif(Revue_h \u003c= 96),\\n    P85PriseEnCharge_h = round(percentile(PriseEnCharge_h, 85), 1),\\n    P85Revue_h = round(percentile(Revue_h, 85), 1)\\n  by Mois = startofmonth(TimeGenerated)\\n| extend ['% prise en charge \u003c= 48h'] = iff(Revues == 0, real(null), round(100.0 * OkPriseEnCharge / Revues, 1)),\\n         ['% revue \u003c= 96h'] = iff(Revues == 0, real(null), round(100.0 * OkRevue / Revues, 1))\\n| project Mois, Cloturees, Revues, SansPriseEnCharge, ['% prise en charge \u003c= 48h'], ['% revue \u003c= 96h'], P85PriseEnCharge_h, P85Revue_h\\n| sort by Mois asc\",\r\n        \"size\": 0,\r\n        \"queryType\": 0,\r\n        \"resourceType\": \"microsoft.operationalinsights/workspaces\",\r\n        \"visualization\": \"table\",\r\n        \"gridSettings\": {\r\n          \"formatters\": [\r\n            {\r\n              \"columnMatch\": \"% prise en charge \u003c= 48h\",\r\n              \"formatter\": 8,\r\n              \"formatOptions\": {\r\n                \"palette\": \"greenRed\"\r\n              },\r\n              \"numberFormat\": {\r\n                \"unit\": 1,\r\n                \"options\": {\r\n                  \"style\": \"decimal\",\r\n                  \"maximumFractionDigits\": 1\r\n                }\r\n              }\r\n            },\r\n            {\r\n              \"columnMatch\": \"% revue \u003c= 96h\",\r\n              \"formatter\": 8,\r\n              \"formatOptions\": {\r\n                \"palette\": \"greenRed\"\r\n              },\r\n              \"numberFormat\": {\r\n                \"unit\": 1,\r\n                \"options\": {\r\n                  \"style\": \"decimal\",\r\n                  \"maximumFractionDigits\": 1\r\n                }\r\n              }\r\n            }\r\n          ]\r\n        }\r\n      },\r\n      \"name\": \"grid-conformite-mensuelle\"\r\n    },\r\n    {\r\n      \"type\": 1,\r\n      \"content\": {\r\n        \"json\": \"### Comparaison entre applications\"\r\n      },\r\n      \"name\": \"text-comparaison\"\r\n    },\r\n    {\r\n      \"type\": 3,\r\n      \"content\": {\r\n        \"version\": \"KqlItem/1.0\",\r\n        \"query\": \"// Heures ouvrées : week-ends exclus, jours ouvrés comptés 24h\\nlet MondayEpoch = datetime(1970-01-05);\\nlet dayIdx = (t: datetime) { toint(datetime_diff('day', startofday(t), MondayEpoch)) };\\nlet weekendDaysBefore = (n: int) { 2 * (n / 7) + max_of(0, min_of(2, n % 7 - 5)) };\\nlet bizHours = (s: datetime, e: datetime) {\\n    let s2 = case(dayofweek(s) == 6d, startofday(s) + 2d, dayofweek(s) == 0d, startofday(s) + 1d, s);\\n    let e2 = case(dayofweek(e) == 6d, startofday(e), dayofweek(e) == 0d, startofday(e) - 1d, e);\\n    iff(e2 \u003c= s2, 0.0, datetime_diff('second', e2, s2) / 3600.0 - 24.0 * (weekendDaysBefore(dayIdx(e2)) - weekendDaysBefore(dayIdx(s2))))\\n};\\nPullRequestMetrics_CL\\n| where TimeGenerated {TimeRange}\\n| where c_eventType in ('merged', 'closed')\\n| where '*' in ({Application}) or c_application in ({Application})\\n| where '*' in ({Repo}) or c_repo in ({Repo})\\n| extend PriseEnCharge_h = bizHours(todatetime(c_cycleStartAt), todatetime(c_reviewStartedAt)),\\n         Revue_h = bizHours(todatetime(c_reviewStartedAt), todatetime(c_closedAt))\\n| summarize\\n    Cloturees = count(),\\n    Mergees = countif(c_eventType == 'merged'),\\n    Revues = countif(isnotnull(c_reviewStartedAt)),\\n    SansPriseEnCharge = countif(isnull(c_reviewStartedAt)),\\n    OkPriseEnCharge = countif(PriseEnCharge_h \u003c= 48),\\n    OkRevue = countif(Revue_h \u003c= 96),\\n    P85PriseEnCharge_h = round(percentile(PriseEnCharge_h, 85), 1),\\n    P85Revue_h = round(percentile(Revue_h, 85), 1)\\n  by Application = c_application, Depot = c_repo\\n| extend ['% prise en charge \u003c= 48h'] = iff(Revues == 0, real(null), round(100.0 * OkPriseEnCharge / Revues, 1)),\\n         ['% revue \u003c= 96h'] = iff(Revues == 0, real(null), round(100.0 * OkRevue / Revues, 1))\\n| project Application, Depot, Cloturees, Mergees, Revues, SansPriseEnCharge, ['% prise en charge \u003c= 48h'], ['% revue \u003c= 96h'], P85PriseEnCharge_h, P85Revue_h\\n| sort by ['% revue \u003c= 96h'] asc\",\r\n        \"size\": 0,\r\n        \"queryType\": 0,\r\n        \"resourceType\": \"microsoft.operationalinsights/workspaces\",\r\n        \"visualization\": \"table\",\r\n        \"gridSettings\": {\r\n          \"formatters\": [\r\n            {\r\n              \"columnMatch\": \"% prise en charge \u003c= 48h\",\r\n              \"formatter\": 8,\r\n              \"formatOptions\": {\r\n                \"palette\": \"greenRed\"\r\n              },\r\n              \"numberFormat\": {\r\n                \"unit\": 1,\r\n                \"options\": {\r\n                  \"style\": \"decimal\",\r\n                  \"maximumFractionDigits\": 1\r\n                }\r\n              }\r\n            },\r\n            {\r\n              \"columnMatch\": \"% revue \u003c= 96h\",\r\n              \"formatter\": 8,\r\n              \"formatOptions\": {\r\n                \"palette\": \"greenRed\"\r\n              },\r\n              \"numberFormat\": {\r\n                \"unit\": 1,\r\n                \"options\": {\r\n                  \"style\": \"decimal\",\r\n                  \"maximumFractionDigits\": 1\r\n                }\r\n              }\r\n            },\r\n            {\r\n              \"columnMatch\": \"SansPriseEnCharge\",\r\n              \"formatter\": 8,\r\n              \"formatOptions\": {\r\n                \"palette\": \"red\"\r\n              }\r\n            }\r\n          ],\r\n          \"filter\": true,\r\n          \"sortBy\": [\r\n            {\r\n              \"itemKey\": \"% revue \u003c= 96h\",\r\n              \"sortOrder\": 1\r\n            }\r\n          ]\r\n        }\r\n      },\r\n      \"name\": \"grid-comparaison\"\r\n    }\r\n  ],\r\n  \"fallbackResourceIds\": [],\r\n  \"styleSettings\": {},\r\n  \"fromTemplateId\": \"lv-pr-leadtime\"\r\n}\r\n",
